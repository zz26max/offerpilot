# OfferPilot local environment template.
# Copy to `.env` for docker compose, or export the variables for a local Maven run.
# `docker compose` reads MYSQL_*, RABBITMQ_*, JWT_SECRET_KEY, GOOGLE_*, CACHE_TTL and OTEL_*.
# SPRING_DATASOURCE_*, REDIS_HOST/PORT, RABBITMQ_HOST/PORT and RESUME_STORAGE_ROOT
# are primarily for starting the backend outside Docker.
# Never commit real credentials.

# --- Database (docker compose maps host 3307 -> mysql 3306) ---
MYSQL_DATABASE=jobportal
MYSQL_USER=jobuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/jobportal?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=jobuser
SPRING_DATASOURCE_PASSWORD=change-me

# --- Redis / cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=5m
CACHE_KEY_PREFIX=offerpilot::

# --- RabbitMQ / resume outbox ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=jobuser
RABBITMQ_PASSWORD=change-me
RESUME_STORAGE_ROOT=./data/resumes
RESUME_OUTBOX_POLL_INTERVAL=1s
RESUME_OUTBOX_BATCH_SIZE=20
RESUME_OUTBOX_CLAIM_LEASE=30s
RESUME_PARSE_MAX_ATTEMPTS=3

# --- Auth (JWT secret must be >= 256 bit in production) ---
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Optional Google OIDC; leave empty if not configured ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observability (optional for local runs) ---
OTEL_SERVICE_NAME=job-portal-backend
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
